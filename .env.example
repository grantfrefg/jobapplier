# ApplyPilot Environment Configuration
# Copy to ~/.applypilot/.env and fill in your values.
# Keep comments on their own lines: "KEY=   # note" makes the note the value.

# AI provider: scores jobs, writes resumes and cover letters, answers application forms.
# Google Gemini (free tier; recommended). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Or your own paid key (pay per use; separate from a ChatGPT / Claude subscription):
# OPENAI_API_KEY=          (default model gpt-5-mini)
# ANTHROPIC_API_KEY=       (default model claude-opus-5-5)
# Or a local LLM (llama.cpp, Ollama):
# LLM_URL=http://127.0.0.1:8080/v1
# Which one to use when several keys are set: gemini, openai, anthropic or local
# (unset: the local server, then Gemini, OpenAI, Anthropic, whichever has a key)
# LLM_PROVIDER=
# Override the model (only used when it names a model of the chosen provider):
# LLM_MODEL=

# Daily Gemini request budget (free tier; resets at midnight US Pacific time).
# Finding/preparing jobs stops once only the apply reserve is left.
# GEMINI_DAILY_LIMIT=500
# GEMINI_APPLY_RESERVE=50

# Auto-Apply engine (Stage 6)
#   claude_code      -> paid Claude Code CLI agent; submits automatically (default if unset)
#   codex            -> OpenAI's Codex CLI agent (run 'codex login' once); submits automatically
#   local_playwright -> local Playwright browser + the AI provider above.
#                       Fills forms, then pauses for YOU to review and click Submit.
EXECUTION_ENGINE=claude_code
# Model for the codex engine (optional; Codex's default otherwise)
# CODEX_MODEL=

# Auto-Apply (optional): CAPTCHA solving for the claude_code engine
CAPSOLVER_API_KEY=

# Proxy (optional, for scraping)
# PROXY=host:port:user:pass
