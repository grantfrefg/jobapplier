# ApplyPilot Environment Configuration
# Copy to ~/.applypilot/.env and fill in your values.

# LLM Provider (pick one)
GEMINI_API_KEY=           # Google Gemini (free tier; recommended). Get one at aistudio.google.com/apikey
# OPENAI_API_KEY=         # OpenAI (GPT-4o-mini)
# LLM_URL=http://127.0.0.1:8080/v1  # Local LLM (llama.cpp, Ollama)
# LLM_MODEL=              # Override model name

# Auto-Apply engine (Stage 6)
#   claude_code      -> paid Claude Code CLI agent (default if unset)
#   local_playwright -> free local Playwright browser + your GEMINI_API_KEY.
#                       Fills forms, then pauses for YOU to review and click Submit.
#                       Uses LLM_MODEL if it is a Gemini model, else gemini-2.5-flash.
EXECUTION_ENGINE=claude_code

# Auto-Apply (optional)
CAPSOLVER_API_KEY=        # For CAPTCHA solving during auto-apply

# Proxy (optional, for scraping)
# PROXY=host:port:user:pass
